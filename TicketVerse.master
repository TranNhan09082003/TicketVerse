<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="TicketVerse.master.cs" Inherits="TranTrongNhan_35011.TicketVerseMaster" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TicketVerse — Sàn Vé Sự Kiện & Trải Nghiệm</title>
    <meta name="description" content="TicketVerse - Nền tảng mua bán vé sự kiện, concert, workshop, thể thao và trải nghiệm hàng đầu Việt Nam" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Assets/css/ticketverse.css") %>" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- NAVBAR -->
        <nav class="tv-navbar">
            <a href="<%= ResolveUrl("~/TrangChu.aspx") %>" class="tv-logo">
                🎫 <span>TicketVerse</span>
            </a>
            <ul class="tv-nav-links">
                <li><a href="<%= ResolveUrl("~/TrangChu.aspx") %>">Trang Chủ</a></li>
                <li><a href="<%= ResolveUrl("~/DanhSachSuKien.aspx") %>">Sự Kiện</a></li>
                <li><a href="<%= ResolveUrl("~/About.aspx") %>">Giới Thiệu</a></li>
                <li><a href="<%= ResolveUrl("~/Contact.aspx") %>">Liên Hệ</a></li>
            </ul>
            <div class="tv-nav-actions">
                <a href="<%= ResolveUrl("~/GioHang.aspx") %>" class="tv-cart-btn" title="Giỏ hàng">
                    🛒
                    <span class="tv-cart-badge" style="display:none;">0</span>
                </a>
                <asp:Panel ID="pnlGuest" runat="server">
                    <a href="<%= ResolveUrl("~/DangNhap.aspx") %>" class="tv-user-btn">Đăng Nhập</a>
                </asp:Panel>
                <asp:Panel ID="pnlUser" runat="server" Visible="false">
                    <a href="<%= ResolveUrl("~/TaiKhoan.aspx") %>" class="tv-user-btn" style="background: var(--grad-fun);">
                        👤 <asp:Label ID="lblUserName" runat="server" Text="User"></asp:Label>
                    </a>
                </asp:Panel>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- FOOTER -->
        <footer class="tv-footer">
            <div class="tv-footer-grid">
                <div class="tv-footer-brand">
                    <h3>🎫 <span>TicketVerse</span></h3>
                    <p>Nền tảng mua bán vé sự kiện và trải nghiệm hàng đầu Việt Nam. Khám phá concert, workshop, thể thao và nhiều hơn nữa!</p>
                </div>
                <div>
                    <h4>Khám Phá</h4>
                    <ul class="tv-footer-links">
                        <li><a href="<%= ResolveUrl("~/DanhSachSuKien.aspx") %>">Tất cả sự kiện</a></li>
                        <li><a href="#">Concert & Âm nhạc</a></li>
                        <li><a href="#">Workshop</a></li>
                        <li><a href="#">Thể thao</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Hỗ Trợ</h4>
                    <ul class="tv-footer-links">
                        <li><a href="#">Hướng dẫn mua vé</a></li>
                        <li><a href="#">Chính sách hoàn vé</a></li>
                        <li><a href="#">FAQ</a></li>
                        <li><a href="<%= ResolveUrl("~/Contact.aspx") %>">Liên hệ</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Kết Nối</h4>
                    <ul class="tv-footer-links">
                        <li><a href="#">📘 Facebook</a></li>
                        <li><a href="#">📸 Instagram</a></li>
                        <li><a href="#">🐦 Twitter</a></li>
                        <li><a href="#">📧 Email</a></li>
                    </ul>
                </div>
            </div>
            <div class="tv-footer-bottom">
                <p>&copy; 2026 TicketVerse — Đồ án Kỹ Thuật Thương Mại Điện Tử | Nhóm 6 thành viên</p>
            </div>
        </footer>
    </form>
    <script src="<%= ResolveUrl("~/Assets/js/ticketverse.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
